    {
      "id": "camera",
      "section": "Rome",
      "question": "How does the camera handle two players?",
      "who_decides": "Parent",
      "answered": true,
      "answer_values": "shared_zoom",
      "answer_labels": "One shared screen that zooms",
      "claude_suggested": [
        "shared_zoom"
      ],
      "note": "zoom up to a limit - beyond that initially we can just stop players moving further apart, ideally eventually it would be shared screen - until you are too far apart then it splits off into split screen and then merges back into shared screen again when close enough together again - this is the best compromise I've seen done for this kind of co-op game.",
      "answered_by": "Amelia",
      "updated_at": "2026-11-01T20:06:09.455Z"
    },
