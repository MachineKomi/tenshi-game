    {
      "id": "fail_rule",
      "section": "Loop",
      "question": "What happens if you mess up?",
      "who_decides": "Both",
      "answered": true,
      "answer_values": null,
      "answer_labels": null,
      "claude_suggested": [
        "never_fail"
      ],
      "other": "platforming you always just get set back a little ways - you can restore from your companions location so long as one of you survives OR if you both die / KO then you are reset to frequent checkpoints - for the rhythm game you can't \"fail\" but the power up and other benefits is based on how well you perform at the rhythm game. For the avarice 3 style battle / vampire survivors style auto battle with generals - you CAN fail but there is no penalty for failure other than you have to try again and it encourages you to try again and suggests what you can do to make it easier next time (rescue more creatures or power them up more through more dancing). ",
      "answered_by": "Amelia",
      "updated_at": "2026-11-01T19:57:48.216Z"
    },
